# Vectis environment configuration
# Copy this file to .env and adjust as needed

# Database file (overrides default in config.py)
VECTIS_DB_PATH=vectis.db

# Heartbeat poll interval in seconds (default: 30)
# Set to 300 for 5 minutes to reduce wake-ups
VECTIS_POLL_INTERVAL=300

# Maximum number of tickets processed per heartbeat (default: 1)
VECTIS_MAX_CONCURRENT=1

# Maximum tokens per LLM call (default: 4096)
# Reduce to 512 to limit output tokens and cost
VECTIS_MAX_TOKENS=512

# LLM temperature (default: 0.3)
# Set to 0.0 for deterministic output
VECTIS_TEMPERATURE=0.0

# Maximum retries for LLM calls (default: 3)
VECTIS_MAX_RETRIES=3

# Note: To use the cheapest model, ensure you have an API key for:
#   GEMINI_API_KEY (for gemini/gemini-2.5-flash)
#   or set agents to use openai/gpt-4o-mini via OPENAI_API_KEY
#   (see config.py for model costs)

GEMINI_API_KEY=your_gemini_api_key_here